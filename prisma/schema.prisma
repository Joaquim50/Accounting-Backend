generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Customer {
  id              String             @id @default(uuid()) @db.Uuid
  companyName     String
  contactPerson   String
  phoneNumber     String
  email           String
  ccEmails        String[]
  clientLogo      String?
  addressLine1    String
  addressLine2    String?
  country         String
  state           String
  city            String
  pincode         String
  status          CustomerStatus     @default(ACTIVE)
  
  // Tax details
  gstApplicable   Boolean            @default(false)
  gstinNumber     String?
  verifiedGstinName String?
  panNumber       String?
  tdsApplicable   Boolean            @default(false)
  tdsPercentage   Decimal?           @db.Decimal(5, 2)
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  documents       CustomerDocument[]
  projectedSales  ProjectedSale[]
  amcs            Amc[]
  proformaInvoices ProformaInvoice[]
  taxInvoices     TaxInvoice[]

  @@map("customers")
}

model CustomerDocument {
  id               String   @id @default(uuid()) @db.Uuid
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId       String   @db.Uuid
  documentType     String
  originalFileName String
  storedFileName   String
  mimeType         String
  fileSize         Int
  uploadedBy       String?  @db.Uuid
  versionNumber    Int      @default(1)
  remarks          String?
  isLatest         Boolean  @default(true)
  uploadedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  @@map("customer_documents")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum VendorType {
  INDIVIDUAL
  COMPANY
}

model Vendor {
  id                    String           @id @default(uuid()) @db.Uuid
  vendorType            VendorType       @default(COMPANY)
  companyName           String?          // Nullable, required only if COMPANY
  vendorName            String
  phoneNumber           String
  email                 String
  ccEmails              String[]
  status                VendorStatus     @default(ACTIVE)
  clientLogo            String?          // Stores uploaded logo path

  // Tax Details
  gstApplicable         Boolean          @default(false)
  gstinNumber           String?
  verifiedGstinName     String?
  panNumber             String?
  panName               String?
  tdsApplicable         Boolean          @default(false)
  tdsSection            String?
  tdsPercentage         Decimal?         @db.Decimal(5, 2)

  // Address Details
  addressLine1          String
  addressLine2          String?
  country               String           @default("India")
  state                 String
  city                  String
  pincode               String

  // Bank Details
  bankAccountHolderName String?
  bankName              String?
  bankAccountNumber     String?
  bankIfscCode          String?
  bankSwiftCode         String?
  bankBranchName        String?

  // Audit Fields
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?

  documents             VendorDocument[]
  payments              Payment[]

  @@map("vendors")
  @@index([vendorName])
  @@index([companyName])
  @@index([email])
  @@index([phoneNumber])
  @@index([status])
  @@index([deletedAt])
}

model VendorDocument {
  id               String    @id @default(uuid()) @db.Uuid
  vendor           Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId         String    @db.Uuid
  documentType     String    // "PAN", "GSTIN", "TDS", "MSME", "PO", "Agreement/Contract", "Invoice", "Bank Details", "Aadhaar / ID", "Other Documents"
  originalFileName String
  storedFileName   String
  mimeType         String
  fileSize         Int
  versionNumber    Int       @default(1)
  remarks          String?
  isLatest         Boolean   @default(true)
  uploadedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@map("vendor_documents")
}

model Employee {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  
  // Audit Fields
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  payments     Payment[]

  @@map("employees")
  @@index([name])
  @@index([deletedAt])
}

enum PaymentFrequency {
  ONE_TIME
  RECURRING
}

enum PartyType {
  VENDOR
  EMPLOYEE
  HOUSEHOLD
  OTHER
}

enum DeductionType {
  NONE
  TDS
  PT
  OTHER
}

enum PaymentStatus {
  PENDING
  PART_PAID
  PAID
}

model Payment {
  id                      String           @id @default(uuid()) @db.Uuid
  paymentFrequency        PaymentFrequency @default(ONE_TIME) @map("payment_frequency")
  expenseDate             DateTime         @map("expense_date") @db.Date
  expenseType             String           @map("expense_type")
  partyType               PartyType        @map("party_type")
  
  // Relations/Custom Parties
  vendorId                String?          @db.Uuid @map("vendor_id")
  vendor                  Vendor?          @relation(fields: [vendorId], references: [id])
  employeeId              String?          @db.Uuid @map("employee_id")
  employee                Employee?        @relation(fields: [employeeId], references: [id])
  partyNameCustom         String?          @map("party_name_custom")

  notes                   String?          @db.Text

  // Financial details
  baseAmount              Decimal          @map("base_amount") @db.Decimal(12, 2)
  gstApplicable           Boolean          @default(false) @map("gst_applicable")
  gstPercentage           Decimal?         @map("gst_percentage") @db.Decimal(5, 2)
  gstAmount               Decimal          @default(0) @map("gst_amount") @db.Decimal(12, 2)

  // Deduction details
  deductionType           DeductionType    @default(NONE) @map("deduction_type")
  deductionPercentageTDS  Decimal?         @map("deduction_percentage_tds") @db.Decimal(5, 2)
  ptAmountFixed           Decimal?         @map("pt_amount_fixed") @db.Decimal(12, 2)
  deductionPercentageOther Decimal?        @map("deduction_percentage_other") @db.Decimal(5, 2)
  deductionAmount         Decimal          @default(0) @map("deduction_amount") @db.Decimal(12, 2)

  netPayable              Decimal          @map("net_payable") @db.Decimal(12, 2)

  // Optional/Payment tracking
  paidAmount              Decimal          @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balance                 Decimal          @default(0) @map("balance") @db.Decimal(12, 2)
  paymentStatus           PaymentStatus    @default(PENDING) @map("payment_status")

  // Audit Fields
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  deletedAt               DateTime?        @map("deleted_at")

  @@map("payments")
  @@index([expenseDate])
  @@index([expenseType])
  @@index([partyType])
  @@index([paymentStatus])
  @@index([deletedAt])
}

enum ProjectType {
  WEBSITE
  WEB_APP
  MOBILE_APP
  SOFTWARE_DEVELOPMENT
  DIGITAL_MARKETING
  BRANDING
  AMC
  RETAINER
  ONE_TIME
  OTHER
}

enum BillingType {
  MILESTONE_BASED
  AMC
  ONE_TIME
  MONTHLY_RETAINER
}

enum ProjectedSaleStatus {
  LEAD
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  INVOICED
  PAID
  CANCELLED
}

enum AMCBillingCycle {
  MONTHLY
  YEARLY
}

model ProjectedSale {
  id                     String                 @id @default(uuid()) @db.Uuid
  customerId             String                 @db.Uuid
  customer               Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectName            String                 @db.VarChar(255)
  projectType            ProjectType
  billingType            BillingType
  totalValue             Decimal                @db.Decimal(12, 2)
  startDate              DateTime               @db.Date
  endDate                DateTime               @db.Date
  gstPercentage          Decimal                @default(0) @db.Decimal(5, 2)
  tdsPercentage          Decimal                @default(0) @db.Decimal(5, 2)
  gstAmount              Decimal                @default(0) @db.Decimal(12, 2)
  tdsAmount              Decimal                @default(0) @db.Decimal(12, 2)
  finalAmount            Decimal                @default(0) @db.Decimal(12, 2)
  status                 ProjectedSaleStatus    @default(LEAD)
  notes                  String?                @db.Text
  
  // AMC specific
  amcDurationMonths      Int?                   @map("amc_duration_months")
  amcBillingCycle        AMCBillingCycle?       @map("amc_billing_cycle")
  
  // Retainer specific
  monthlyRetainerAmount  Decimal?               @map("monthly_retainer_amount") @db.Decimal(12, 2)
  retainerDurationMonths Int?                   @map("retainer_duration_months")

  // Audit Fields
  createdBy              String                 @db.Uuid @map("created_by")
  updatedBy              String                 @db.Uuid @map("updated_by")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  deletedAt              DateTime?              @map("deleted_at")

  milestones             ProjectedSaleMilestone[]
  proformaInvoices       ProformaInvoice[]
  taxInvoices            TaxInvoice[]

  @@map("projected_sales")
  @@index([customerId])
  @@index([status])
  @@index([projectType])
  @@index([billingType])
  @@index([deletedAt])
}

model ProjectedSaleMilestone {
  id              String          @id @default(uuid()) @db.Uuid
  projectedSaleId String          @db.Uuid @map("projected_sale_id")
  projectedSale   ProjectedSale   @relation(fields: [projectedSaleId], references: [id], onDelete: Cascade)
  milestoneName   String          @db.VarChar(255) @map("milestone_name")
  percentage      Decimal         @db.Decimal(5, 2)
  amount          Decimal         @db.Decimal(12, 2)
  dueDate         DateTime        @db.Date @map("due_date")
  status          MilestoneStatus @default(PENDING)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  proformaInvoices       ProformaInvoice[]
  taxInvoices            TaxInvoice[]

  @@map("projected_sale_milestones")
  @@index([projectedSaleId])
}

// ==========================================
// AMC Tracker Enums & Models
// ==========================================

enum AMCBillingFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum AMCStatus {
  ACTIVE
  EXPIRED
  ON_HOLD
  CANCELLED
}

enum PIStatus {
  NOT_RAISED
  SENT
  UPLOADED
}

enum TIStatus {
  NOT_CREATED
  UPLOADED
}

enum AMCPaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMatchStatus {
  PENDING
  MATCHED
}

model Amc {
  id                 String               @id @default(uuid()) @db.Uuid
  customerId         String               @db.Uuid @map("customer_id")
  customer           Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amcName            String               @db.VarChar(255) @map("amc_name")
  startDate          DateTime             @db.Date @map("start_date")
  endDate            DateTime             @db.Date @map("end_date")
  billingFrequency   AMCBillingFrequency  @map("billing_frequency")
  status             AMCStatus            @default(ACTIVE)
  baseAmountPerCycle Decimal              @db.Decimal(12, 2) @map("base_amount_per_cycle")
  gstPercentage      Decimal              @default(0) @db.Decimal(5, 2) @map("gst_percentage")
  tdsPercentage      Decimal              @default(0) @db.Decimal(5, 2) @map("tds_percentage")
  gstAmount          Decimal              @default(0) @db.Decimal(12, 2) @map("gst_amount")
  tdsAmount          Decimal              @default(0) @db.Decimal(12, 2) @map("tds_amount")
  grossAmount        Decimal              @default(0) @db.Decimal(12, 2) @map("gross_amount")
  expectedAmount     Decimal              @default(0) @db.Decimal(12, 2) @map("expected_amount")
  nextBillingDate    DateTime?            @db.Date @map("next_billing_date")
  notes              String?              @db.Text

  // Audit Fields
  createdBy          String               @db.Uuid @map("created_by")
  updatedBy          String               @db.Uuid @map("updated_by")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  deletedAt          DateTime?            @map("deleted_at")

  billingCycles      AmcBillingCycle[]

  @@map("amcs")
  @@index([customerId])
  @@index([status])
  @@index([billingFrequency])
  @@index([deletedAt])
}

model AmcBillingCycle {
  id                 String             @id @default(uuid()) @db.Uuid
  amcId              String             @db.Uuid @map("amc_id")
  amc                Amc                @relation(fields: [amcId], references: [id], onDelete: Cascade)
  cycleName          String             @db.VarChar(100) @map("cycle_name")
  dueDate            DateTime           @db.Date @map("due_date")
  baseAmount         Decimal            @db.Decimal(12, 2) @map("base_amount")
  gstAmount          Decimal            @db.Decimal(12, 2) @map("gst_amount")
  grossAmount        Decimal            @db.Decimal(12, 2) @map("gross_amount")
  tdsAmount          Decimal            @db.Decimal(12, 2) @map("tds_amount")
  expectedAmount     Decimal            @db.Decimal(12, 2) @map("expected_amount")
  receivedAmount     Decimal            @default(0) @db.Decimal(12, 2) @map("received_amount")
  outstandingAmount  Decimal            @db.Decimal(12, 2) @map("outstanding_amount")
  piStatus           PIStatus           @default(NOT_RAISED) @map("pi_status")
  tiStatus           TIStatus           @default(NOT_CREATED) @map("ti_status")
  paymentStatus      AMCPaymentStatus   @default(PENDING) @map("payment_status")
  paymentMatchStatus PaymentMatchStatus @default(PENDING) @map("payment_match_status")
  remarks            String?            @db.Text

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("amc_billing_cycles")
  @@index([amcId])
  @@index([piStatus])
  @@index([tiStatus])
  @@index([paymentStatus])
  @@index([paymentMatchStatus])
}

// ==========================================
// Proforma & Tax Invoice Models & Enums
// ==========================================

enum ProformaInvoiceStatus {
  DRAFT
  SENT
  PENDING
  PARTIALLY_PAID
  PAID
  SHORTFALL
  CANCELLED
}

enum TaxInvoiceStatus {
  DRAFT
  GENERATED
  SENT
  CANCELLED
}

model ProformaInvoice {
  id                     String                 @id @default(uuid()) @db.Uuid
  piNumber               String                 @unique @map("pi_number") @db.VarChar(100)
  piDate                 DateTime               @map("pi_date") @db.Date
  clientId               String                 @db.Uuid @map("client_id")
  customer               Customer               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId              String?                @db.Uuid @map("project_id")
  projectedSale          ProjectedSale?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestoneId            String?                @db.Uuid @map("milestone_id")
  milestone              ProjectedSaleMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  baseAmount             Decimal                @db.Decimal(12, 2) @map("base_amount")
  gstPercentage          Decimal                @default(0) @db.Decimal(5, 2) @map("gst_percentage")
  gstAmount              Decimal                @default(0) @db.Decimal(12, 2) @map("gst_amount")
  grossAmount            Decimal                @default(0) @db.Decimal(12, 2) @map("gross_amount")
  tdsPercentage          Decimal                @default(0) @db.Decimal(5, 2) @map("tds_percentage")
  tdsAmount              Decimal                @default(0) @db.Decimal(12, 2) @map("tds_amount")
  expectedReceiptAmount  Decimal                @default(0) @db.Decimal(12, 2) @map("expected_receipt_amount")
  amountReceived         Decimal                @default(0) @db.Decimal(12, 2) @map("amount_received")
  outstandingAmount      Decimal                @default(0) @db.Decimal(12, 2) @map("outstanding_amount")
  status                 ProformaInvoiceStatus  @default(DRAFT)
  piFile                 String?                @map("pi_file") @db.VarChar(500)
  notes                  String?                @db.Text
  
  // Audit fields
  createdBy              String                 @db.Uuid @map("created_by")
  updatedBy              String                 @db.Uuid @map("updated_by")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  deletedAt              DateTime?              @map("deleted_at")

  taxInvoice             TaxInvoice?

  @@map("proforma_invoices")
  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
}

model TaxInvoice {
  id                     String                 @id @default(uuid()) @db.Uuid
  tiNumber               String                 @unique @map("ti_number") @db.VarChar(100)
  tiDate                 DateTime               @map("ti_date") @db.Date
  piId                   String?                @unique @db.Uuid @map("pi_id")
  proformaInvoice        ProformaInvoice?       @relation(fields: [piId], references: [id], onDelete: SetNull)
  clientId               String                 @db.Uuid @map("client_id")
  customer               Customer               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId              String?                @db.Uuid @map("project_id")
  projectedSale          ProjectedSale?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestoneId            String?                @db.Uuid @map("milestone_id")
  milestone              ProjectedSaleMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  baseAmount             Decimal                @db.Decimal(12, 2) @map("base_amount")
  gstPercentage          Decimal                @default(0) @db.Decimal(5, 2) @map("gst_percentage")
  gstAmount              Decimal                @default(0) @db.Decimal(12, 2) @map("gst_amount")
  grossAmount            Decimal                @default(0) @db.Decimal(12, 2) @map("gross_amount")
  tdsPercentage          Decimal                @default(0) @db.Decimal(5, 2) @map("tds_percentage")
  tdsAmount              Decimal                @default(0) @db.Decimal(12, 2) @map("tds_amount")
  expectedReceiptAmount  Decimal                @default(0) @db.Decimal(12, 2) @map("expected_receipt_amount")
  amountReceived         Decimal                @default(0) @db.Decimal(12, 2) @map("amount_received")
  outstandingAmount      Decimal                @default(0) @db.Decimal(12, 2) @map("outstanding_amount")
  status                 TaxInvoiceStatus       @default(DRAFT)
  tiFile                 String?                @map("ti_file") @db.VarChar(500)
  notes                  String?                @db.Text

  // Audit fields
  createdBy              String                 @db.Uuid @map("created_by")
  updatedBy              String                 @db.Uuid @map("updated_by")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  deletedAt              DateTime?              @map("deleted_at")

  @@map("tax_invoices")
  @@index([piId])
  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
}


